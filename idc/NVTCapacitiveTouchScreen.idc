# Basic Parameters
touch.deviceType = touchScreen
touch.orientationAware = 1

# Disable Size Calibration (The Ultimate Fix for Left Analog Drop)
touch.size.calibration = none
touch.size.scale = 0
touch.size.bias = 0
touch.size.isSum = 0

# Disable Pressure Calibration
touch.pressure.calibration = none

# Gesture Mode (Spots to prevent pointer splitting)
touch.gestureMode = spots

# Filter Level 2 for 500Hz Turbo Touch (Micro-jitter rejection)
touch.filter.level = 2
