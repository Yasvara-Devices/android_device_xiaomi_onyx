<resources>
    <!-- boolean indicating whether the WiFi chipset has 5GHz band support.
         Note: This config is replacing the config_wifi_dual_band_support
         since more bands may now be supported (such as 6GHz), the naming dual_band
         is no longer indicative, and a separate config now exists for each band -->
    <bool name="config_wifi5ghzSupport">true</bool>

    <!-- boolean indicating whether the WiFi chipset has 6GHz band support -->
    <bool name="config_wifi6ghzSupport">true</bool>

    <!-- Boolean indicating whether the wifi chipset supports background scanning mechanism.
         This mechanism allows the host to remain in suspend state and the dongle to actively
         scan and wake the host when a configured SSID is detected by the dongle. This chipset
         capability can provide power savings when wifi needs to be always kept on. -->
    <bool name="config_wifi_background_scan_support">true</bool>

    <!-- Integer indicating maximum hardware supported client number of soft ap -->
    <integer name="config_wifiHardwareSoftapMaxClientCount">32</integer>

    <!-- boolean indicating whether or not to auto-upgrade band setting configuration to dual bands during cloud configuration restore when device supported -->
    <bool name="config_wifiSoftapAutoUpgradeToBridgedConfigWhenSupported">false</bool>

    <!-- List of allowed channels in 2GHz band for softap. If the device doesn't want to restrict
         channels this should be empty. Values is a comma separated channel string and/or channel
         range string like '1-6,11'. -->
    <string name="config_wifiSoftap2gChannelList" translatable="false"/>

    <!-- Boolean indicating performing a partial initial scan is enabled -->
    <bool name="config_wifiEnablePartialInitialScan">true</bool>

    <!-- Boolean indicating that only configurations that have the same pre-shared key will be linked -->
    <bool name="config_wifi_only_link_same_credential_configurations">false</bool>

    <!-- Wifi driver supports Automatic channel selection (ACS) for softap -->
    <bool name="config_wifi_softap_acs_supported">true</bool>

    <!-- Wifi driver supports WPA3 Simultaneous Authentication of Equals (WPA3-SAE) for softap -->
    <bool name="config_wifi_softap_sae_supported">true</bool>

    <!-- Wifi driver supports IEEE80211AC for softap -->
    <bool name="config_wifi_softap_ieee80211ac_supported">true</bool>

    <!-- Wifi driver supports IEEE80211AX for softap -->
    <bool name="config_wifiSoftapIeee80211axSupported">true</bool>

    <!-- Wifi driver supports IEEE80211AX single user beamformer for softap -->
    <bool name="config_wifiSoftapHeSuBeamformerSupported">true</bool>

    <!-- Wifi driver supports IEEE80211AX single user beamformee for softap -->
    <bool name="config_wifiSoftapHeSuBeamformeeSupported">true</bool>

    <!-- Wifi driver supports 6GHz band for softap when chip support 6GHz -->
    <bool name="config_wifiSoftap6ghzSupported">true</bool>

    <!-- Indicates that connected MAC randomization is supported on this device -->
    <bool name="config_wifi_connected_mac_randomization_supported">true</bool>

    <!-- Indicates that p2p MAC randomization is supported on this device -->
    <bool name="config_wifi_p2p_mac_randomization_supported">true</bool>

    <!-- Indicates that dynamic country code update in AP mode is supported on this device -->
    <bool name="config_wifiSoftApDynamicCountryCodeUpdateSupported">true</bool>

    <!-- Indicates that dynamic country code update in STA mode is supported on this device -->
    <bool name="config_wifiStaDynamicCountryCodeUpdateSupported">true</bool>

    <!-- Learn the country from nearby routers (802.11d) when there is no SIM country, so a
         phone without a SIM still gets its country's 5/6 GHz channels. -->
    <bool name="config_wifiUpdateCountryCodeFromScanResultGeneric">true</bool>

    <!-- Configure wifi tcp buffersizes in the form:
         rmem_min,rmem_def,rmem_max,wmem_min,wmem_def,wmem_max
         Aligned with init.onyx.rc so ConnectivityService does not clobber
         tcp_rmem/tcp_wmem defaults down or waste 512KB/256KB min per idle socket. -->
    <string name="config_wifi_tcp_buffers" translatable="false">4096,2097152,16777216,4096,1048576,16777216</string>

    <!-- Do not translate. Default access point SSID used for tethering -->
    <string name="wifi_tether_configure_ssid_default" translatable="false">POCO F7</string>

    <!-- Array describing scanning schedule in seconds when device is disconnected and screen is on
         BUG FIX: Was flat 20s (scan every 20s FOREVER). Now uses AOSP exponential backoff.
         20s → 40s → 80s → 160s = 8x fewer scans after 60s -->
    <integer-array name="config_wifiDisconnectedScanIntervalScheduleSec">
        <item>20</item>
        <item>40</item>
        <item>80</item>
        <item>160</item>
    </integer-array>

    <!-- Connected scan schedule: when already connected, scan for roaming less aggressively
         AOSP default: 20→40→80→160. Relaxed: 30→60→120→300 (5 min max) -->
    <integer-array name="config_wifiConnectedScanIntervalScheduleSec">
        <item>30</item>
        <item>60</item>
        <item>120</item>
        <item>300</item>
    </integer-array>

    <!-- Use LOW_POWER scan type (value=1) instead of HIGH_ACCURACY (value=2)
         Trades ~200ms latency for significantly less radio power per scan -->
    <integer-array name="config_wifiDisconnectedScanType">
        <item>1</item>
    </integer-array>
    <integer-array name="config_wifiConnectedScanType">
        <item>1</item>
    </integer-array>

    <!-- List of constants to indicate how many failures are needed to temporarily disable a network
    from auto-connect -->
    <integer name="config_wifiDisableReasonAssociationRejectionThreshold">5</integer>
    <integer name="config_wifiDisableReasonAuthenticationFailureThreshold">5</integer>
    <integer name="config_wifiDisableReasonByWrongPasswordThreshold">2</integer>

    <!-- Controls whether a wifi connection with RSSI lower than the sufficient RSSI will be
    temporarily disabled when it is unwanted by core networking -->
    <bool name="config_wifiDisableUnwantedNetworkOnLowRssi">true</bool>

    <!-- Enable WPA2 to WPA3 auto-upgrade offload to capable Driver/Firmware -->
    <bool name="config_wifiSaeUpgradeOffloadEnabled">true</bool>

    <!-- Wifi driver Automatic channel selection (ACS) for softap to include DFS channels -->
    <bool name="config_wifiSoftapAcsIncludeDfs">true</bool>

    <!-- Interval Multiplier for PNO scan. After not finding any networks for
         config_wifiPnoScanIterations, PNO will multiply the scan interval by the value
         configured. Increased 6→10 for less radio wakeups during idle -->
    <integer name="config_wifiPnoScanIntervalMultiplier">10</integer>

    <!-- integer indicating additional disconnect delay (in ms) after IMS onLost() indication is received -->
    <integer name="config_wifiDelayDisconnectOnImsLostMs">1000</integer>

    <!-- Enable Aware NDP interface selection on interface that already has network set up.
     Note: the default AOSP Android does not support multiple networks on the same Aware NDI.
     Enabling this configuration will restore legacy behavior but may result in incorrect behavior.
     -->
    <bool name="config_wifiAllowMultipleNetworksOnSameAwareNdi">true</bool>

    <!-- Whether we should apply APF filters on non primary STA connections when STA + STA is active.
         Defaults to false since most wifi chips cannot support concurrent APF filter set needed for STA + STA-->
    <bool name="config_wifiEnableApfOnNonPrimarySta">true</bool>

    <!-- Whether to use the explicit vendor HAL API: IWifiStaIface.setRoamingState for disabling fw roaming (only needed if
         setting the bssid on the connection alone does not disable fw roaming on this chip) -->
    <bool name="config_wifiUseHalApiToDisableFwRoaming">true</bool>

    <!-- Indicates that SAE Hash-to-Element is supported on this device -->
    <bool name="config_wifiSaeH2eSupported">true</bool>

    <!-- Integer threshold for max number of WifiConfigurations that can be saved on the device.
         A value of -1 indicates no limit. If a max number is specified, then under-used configs will
         be deleted to make room for new configs.-->
    <integer name="config_wifiMaxNumWifiConfigurations">1000</integer>

    <!-- Whether to allow Settings or SUW to create insecure Enterprise networks where server
         certificate is not validated, by not specifying a Root CA certificate and/or server domain
         name. It is STRONGLY RECOMMENDED to be set to false -->
    <bool name="config_wifiAllowInsecureEnterpriseConfigurationsForSettingsAndSUW">true</bool>

    <!-- Indicates whether or not the WLAN driver supports the NL80211_CMD_REG_CHANGE or
         NL80211_CMD_WIPHY_REG_CHANGE events which indicate the current country code which is
         being used by the WLAN driver. If the driver doesn't support these events
         (configuration is `false`) then the driver must handle the setCountryCode request from
         HAL as a blocking call. In such a case the country code will be applied
         immediately after the country code is sent to the driver (if the method returns a
         success). -->
    <bool name="config_wifiDriverSupportedNl80211RegChangedEvent">true</bool>

    <!-- Wifi driver supports Opportunistic Wireless Encryption (OWE) Transition
         aka Enhanced Open for Soft-AP -->
    <bool name="config_wifiSoftapOweTransitionSupported">true</bool>

    <!-- Wifi driver supports Opportunistic Wireless Encryption (OWE)
         aka Enhanced Open for Soft-AP -->
    <bool name="config_wifiSoftapOweSupported">true</bool>

    <!-- Indicates whether or not the Soft AP needs to be restarted when country code changed -->
    <bool name="config_wifiForcedSoftApRestartWhenCountryCodeChanged">false</bool>

    <!-- Indicates the time in milliseconds to wait after creating a P2P interface before treating
         it as low priority when disconnected, allowing it to be deleted to create other
         interfaces. A negative value disables this behavior. -->
    <integer name="config_disconnectedP2pIfaceLowPriorityTimeoutMs">0</integer>

    <!-- Indicates whether the network-centric QoS policy feature is enabled. -->
    <bool name="config_wifiNetworkCentricQosPolicyFeatureEnabled">true</bool>

    <!-- Lists each alternate character set per locale language for SSID translation to UTF-8. This
         will translate all SSIDs encoded with the specified character set from the native layer
         into UTF-8 SSIDs. The translated SSIDs are then converted back to the original character
         set when passed back to the native layer. This effectively switches all non-UTF-8 APs into
         UTF-8 APs from the perspective of the framework and apps, and is intended to provide
         backwards compatibility with apps that only work with UTF-8 SSIDs. Values must be in the
         form of the locale language and canonical java.nio Charset name, separated by a comma. If
         the locale language is "all", then the character set will apply to all locale languages
         that do not specify their own character set. -->
    <string-array name="config_wifiCharsetsForSsidTranslation" translatable="false">
        <item>all,GBK</item>
    </string-array>

    <!-- ====== WiFi Battery Optimizations ====== -->

    <!-- PNO scan intervals (screen off, WiFi disconnected)
         Moving: 20s → 40s (still finds networks within ~40s)
         Stationary: 60s → 120s (phone on desk, no rush) -->
    <integer name="config_wifiMovingPnoScanIntervalMillis">40000</integer>
    <integer name="config_wifiStationaryPnoScanIntervalMillis">120000</integer>
    <!-- Backoff faster to multiplied interval (3 → 2 iterations) -->
    <integer name="config_wifiPnoScanIterations">2</integer>

    <!-- When connected with high RSSI (strong signal), don't scan for better APs for 20 min
         AOSP default: 10 min. Strong signal = no need to look for roaming targets -->
    <integer name="config_wifiConnectedHighRssiScanMinimumWindowSizeSec">1200</integer>

    <!-- Shut down hotspot after 5 min idle instead of 10 min
         Saves power when user forgets to turn off hotspot -->
    <integer name="config_wifiFrameworkSoftApShutDownTimeoutMilliseconds">300000</integer>

    <!-- Enable linked network roaming — allows seamless transition between
         APs with same credentials but different SSIDs (mesh networks)
         Reduces reconnection overhead → fewer full scans -->
    <bool name="config_wifiEnableLinkedNetworkRoaming">true</bool>

    <!-- ====== Channel Unlock / Max Bandwidth ====== -->

    <!-- Enable WiFi 7 (802.11be / EHT) for SoftAP — max throughput -->
    <bool name="config_wifiSoftapIeee80211beSupported">true</bool>

    <!-- Enable STA DFS channels for peer network (P2P/NAN)
         Allows using DFS channels that STA is already connected to -->
    <bool name="config_wifiEnableStaDfsChannelForPeerNetwork">true</bool>

    <!-- Enable STA current connected indoor channel for peer network
         Uses indoor channels that STA is already associated with -->
    <bool name="config_wifiEnableStaIndoorChannelForPeerNetwork">true</bool>

    <!-- ====== WiFi 7 / Full Feature Enablement ====== -->

    <!-- HE MU-MIMO Beamformer for SoftAP — multi-user beamforming
         Framework default: false. WCN7750 supports MU-MIMO -->
    <bool name="config_wifiSoftapHeMuBeamformerSupported">true</bool>

    <!-- HE TWT (Target Wake Time) for SoftAP — WiFi 6E/7 power save
         Allows connected clients to negotiate wake schedules -->
    <bool name="config_wifiSoftapHeTwtSupported">true</bool>

    <!-- Local-only hotspot on 6GHz — enables WiFi Direct / casting on 6GHz
         Less interference, higher throughput for screen mirroring etc -->
    <bool name="config_wifiLocalOnlyHotspot6ghz">true</bool>

    <!-- Local-only hotspot on 5GHz fallback -->
    <bool name="config_wifi_local_only_hotspot_5ghz">true</bool>

    <!-- Map WPA3 transition mode to WPA3-only on 6GHz band
         6GHz requires pure WPA3-SAE, transition mode allowed by spec -->
    <bool name="config_wifiSofapHalMapWpa3TransitionModeToWpa3OnlyIn6GHzBand">true</bool>

</resources>
