persist.log.tag.libsensor-qshcalapi=WARN
persist.log.tag.LocSvc_api_v02=WARN
persist.log.tag.LocSvc_ApiV02=WARN
persist.log.tag.LocSvc_IzatApiV02=WARN
persist.log.tag.QC2Interface=ERROR
persist.log.tag.QC2Filter=ERROR
persist.log.tag.AidlBufferPool=WARN
persist.log.tag.CCodecConfig=WARN
persist.log.tag.CCodec=WARN
persist.log.tag.CCodecBuffers=WARN
