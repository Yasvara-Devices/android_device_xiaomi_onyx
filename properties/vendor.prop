# HWUI
debug.hwui.target_cpu_time_percent=30
debug.hwui.use_hint_manager=true
debug.sf.enable_adpf_cpu_hint=true

# HWUI Vulkan backend — Adreno 830 supports Vulkan 1.3
# Vulkan reduces driver overhead vs OpenGL ES → lower frame latency
ro.hwui.use_vulkan=true
debug.hwui.renderer=skiavk
debug.renderengine.backend=skiavk

# Render-ahead: pipeline 1 frame → smoother 120Hz animations
ro.hwui.render_ahead=2

# SurfaceFlinger layer caching (CachedSet/"Planner" flattener) MUST stay off on onyx:
# flattened cached buffers corrupt on the QTI SDM overlay path -> shadow flicker in
# static UI bands (YouTube Shorts scrims, status bar/taskbar areas) from cold boot.
# Verified on-device 2026-07-16: warm SF restart with =true reproduces, =0 clean.
# NOTE: the persist.sys.sf_layer_caching trigger in init.target.rc fires AFTER
# SurfaceFlinger starts on cold boot, so it cannot be used to disable this.
debug.sf.enable_layer_caching=0

# Incremental FS
ro.incremental.enable=yes

# Keymint
vendor.keymint.retry_timer=5

# Keystore
ro.hardware.keystore_desede=true

# Media
debug.c2.use_dmabufheaps=1
# Every one of the three below is load-bearing, none of them is log tuning.
#
# media.c2.hal.selection: HalSelection.cpp defaults to "hidl" when unset, and the
# QTI Codec2 store is AIDL-only (c2_manifest_vendor{,_audio}.xml declare
# format="aidl"). Unset it and Codec2Client reports
#   Available Codec2 services: "software" "__ApexCodecs__"
# i.e. every c2.qti.* codec disappears, MediaCodecList keeps only the 33 APEX
# software codecs, and MiuiCamera/GCam fall back to c2.android.avc.encoder for
# 4K60 -> "failed to configure c2 params" / BAD_VALUE -> recording dies.
#
# debug.stagefright.c2inputsurface: -1 is what makes CCodec::CreateInputSurface()
# build the AIDL GraphicBufferSource fallback. Without it that function returns
# nullptr and MediaCodec retries over OMX, which this device does not have
# ("Cannot obtain IOmx service" -> "Failed to connect to OMX to create persistent
# input surface"), so MediaRecorder never gets a record surface.
#
# debug.stagefright.ccodec: 4 = all components at their normal rank. It matches
# the framework default, but keep it explicit — 0 would hide every codec.
media.c2.hal.selection=aidl
debug.stagefright.c2inputsurface=-1
debug.stagefright.ccodec=4
debug.stagefright.omx_default_rank=0
ro.mediaserver.64b.enable=true
vendor.media.omx=0

# Media (steps)
ro.config.alarm_vol_steps=15
ro.config.media_vol_default=10
ro.config.media_vol_steps=15
ro.config.system_vol_steps=15
ro.config.vc_call_vol_steps=11

# Memory optimization (Beluga)
ro.vendor.beluga.c=0x4800
ro.vendor.beluga.p=0x3
ro.vendor.beluga.s=0x900
ro.vendor.beluga.t=0x240

# Perf
ro.vendor.extension_library=libqti-perfd-client.so
ro.vendor.perf-hal.ver=3.0
ro.vendor.perf.scroll_opt=false
vendor.pasr.activemode.enabled=true
vendor.perf.framepacing.enable=1
vendor.power.pasr.enabled=true

# Touch (500Hz high touch sampling rate — turbosched from EvoX)
persist.sys.turbosched.speed_touch.enable=true
persist.vendor.turbosched.speed_touch.enable=true
persist.sys.turbosched.enable=false
persist.sys.turbosched.enable_v2=false
persist.sys.turbosched.local.enable_v2=true
persist.sys.turbosched.gaea.enable=true
persist.sys.turbosched.enable.coreApp.optimizer=true
persist.sys.turbosched.enabletop20app=true
persist.sys.turbosched.local.coreApp.enable=true
persist.sys.turbosched.local.coreAppTop20.enable=true
persist.sys.turbosched.csprotect.enable=6
persist.sys.turbosched.local.csprotect.enable=6
persist.sys.turbosched.feature_list=wakeup
persist.sys.turbosched.local.feature_list=wakeup
persist.sys.turbosched.policy_list=link,priority
persist.sys.turbosched.local.policy_list=link,priority
persist.sys.turbosched.viptask.schlat.enable=true
persist.sys.turbosched.local.viptask.schlat.enable=true
persist.sys.turbosched.viptask.balance.enable=false
persist.sys.turbosched.thermal_break.enable=false
log.tag.turbosched_hwc=S


# QCOM
ro.soc.manufacturer=QTI

# QSPM
ro.vendor.qspm.enable=true

# QSYSD
persist.vendor.qcomsysd.enabled=1

# RIL
persist.radio.multisim.config=dsds
# persist.vendor.radio.add_power_save MUST be set to 0:
# When set to 1, Qualcomm QCRIL enters aggressive DSDS power-saving mode which shuts down
# the 5G NR RF receiver/transceiver chains on the secondary SIM slot (slot 1 / SIM 2)
# during idle/standby, completely breaking 5G SA/NSA detection and attachment on SIM 2 (e.g. Jio 5G SA).
persist.vendor.radio.add_power_save=0
persist.vendor.radio.apm_sim_not_pwdn=1
persist.vendor.radio.custom_ecc=1
persist.vendor.radio.enableadvancedscan=true
persist.vendor.radio.procedure_bytes=SKIP
persist.vendor.radio.sib16_support=1
persist.vendor.rcs.singlereg.feature=1
ro.vendor.radio.build_profile=miui
# ro.vendor.radio.build_region is set per-variant from odm_${ro.boot.hwc}.prop.
# Do not set it here as well: /odm is loaded after /vendor, so an odm value would
# win anyway, but only after init logs an "Overriding previous property" warning
# on every boot. Keeping the single source of truth in the per-variant file avoids
# that. Previously this was hardcoded to "global", so CN hardware (Redmi Turbo
# 4 Pro, ro.boot.hwc=CN) was told build_region=global on a CN modem image.

# Unlock Unrestricted Mode 33 (All Bands) & 5G SA (Standalone n78 3500MHz) for both Slot 0 (SIM 1) and Slot 1 (SIM 2)
ro.telephony.default_network=33,33
telephony.lteOnCdmaDevice=1
persist.vendor.radio.rat_on=combine
persist.vendor.radio.5g_mode_pref=3
persist.vendor.radio.5g_mode_pref_0=3
persist.vendor.radio.5g_mode_pref_1=3
persist.vendor.radio.nr_mode=3
persist.vendor.radio.nr_mode_0=3
persist.vendor.radio.nr_mode_1=3
persist.vendor.radio.5g_sa_enable=1
persist.vendor.radio.5g_sa_enable_0=1
persist.vendor.radio.5g_sa_enable_1=1
persist.vendor.radio.5g_sa_val=1
persist.vendor.radio.5g_sa_val_0=1
persist.vendor.radio.5g_sa_val_1=1
persist.sys.miui.5g.sa_mode=1
persist.sys.miui.5g.sa_mode_0=1
persist.sys.miui.5g.sa_mode_1=1
persist.vendor.radio.sa_nr_drop_req=0
persist.vendor.radio.sa_nr_drop_req_0=0
persist.vendor.radio.sa_nr_drop_req_1=0
persist.vendor.radio.data_con_rprt_0=1
persist.vendor.radio.data_con_rprt_1=1
persist.vendor.radio.dynamic_sar_0=1
persist.vendor.radio.dynamic_sar_1=1


# Bluetooth High-Res Audio Master Optimization (LDAC 990kbps, AptX Lossless, LHDC v5)
persist.vendor.btstack.enable_lhdcv5=true
persist.vendor.btstack.enable_aptx_lossless=true
persist.vendor.btstack.ldac_quality=100
persist.bluetooth.bta2dp.ldac.quality=hq
persist.vendor.bt.a2dp_offload.cap=sbc-aac-aptx-aptxhd-ldac-aptxadapt

# Sensors
ro.vendor.sensors.xiaomi.single_tap=true
ro.vendor.sensors.xiaomi.udfps=true
# device_orient ADSP sensor offset. With stock Xiaomi mapping, values are 0-based
# (0=portrait, 1=landscape, 2=reverse, 3=seascape). No offset needed.
persist.sys.orientation.sensor_offset=0

# Shutdown
sys.vendor.shutdown.waittime=500

# SSR
ro.vendor.vm.ssr.enable=false

# USB
ro.recovery.usb.adb.pid=D001
ro.recovery.usb.fastboot.pid=4EE0
ro.recovery.usb.vid=18D1
ro.usb.uvc.enabled=false
sys.usb.mtp.batchcancel=1
vendor.usb.controller=a600000.dwc3
vendor.usb.diag.func.name=ffs
vendor.usb.dpl.inst.name=dpl
vendor.usb.qdss.inst.name=qdss_sw
vendor.usb.rmnet.func.name=gsi
vendor.usb.rmnet.inst.name=rmnet
vendor.usb.rndis.func.name=gsi
vendor.usb.use_ffs_mtp=1
vendor.usb.use_gadget_hal=1

# WiFi
wifi.aware.interface=wifi-aware0

# Input: disable framework touch resampling — the panel already delivers
# real 500Hz samples; resampling only adds latency and synthetic points.
ro.input.resampling=0

# Hidden God-Tier Vulkan & SF Settings (From AOSP 16)
# (cached_set_render_scheduling removed: only meaningful with layer caching,
#  which is disabled above due to HWC overlay-path corruption on onyx)
debug.graphics.angle.developeroption.enable=true
renderthread.skia.reduceopstasksplitting=true
debug.hwui.use_gpu_pixel_buffers=true

# Treat these packages as privileged camera clients (larger JPEG buffers, relaxed
# sensor-pixel-mode checks). Real 50MP lives on camera id 5 and needs no help here.
persist.vendor.camera.privapp.list=org.codeaurora.snapcam,com.google.android.GoogleCamera,com.android.camera
persist.vendor.camera.remosaic.enable=1
# Keep the SYSTEM_ONLY cameras (5, 6) hidden. Exposing them publishes camera ids
# 5 and 6 to every app; GCam/AGC enumerates them, finds a characteristic missing on
# one of them and dies on Optional.get() with NoSuchElementException before the
# viewfinder ever opens. The useful aux lens (ultrawide = camera 2) is public either
# way, so this costs nothing. Verified: aux=1 -> crash, aux=0 -> launches clean.
persist.vendor.camera.expose.aux=0

# Vendor log chattiness suppression
persist.log.tag.vendor.qti.camera.provider-service_64=S
persist.log.tag.RequestManager=S
persist.log.tag.qcrilNrd=S
persist.log.tag.vendor.qti.bluetooth@1.0-ibs_handler=S
