import /vendor/etc/init/hw/init.batterysecret.rc
# mi_thermald is retired: the kernel-node control it used to do now lives in
# mi_thermal_engine (vendor daemon, see sepolicy/vendor/mi_thermal_engine.te),
# driven by Pentas over persist.sys.mithermal.*. The blob itself is no longer
# shipped, so init.mi_thermald.rc does not exist any more — this line stays
# commented out as the guard in case a blob re-extract re-adds it. Do not restore.
# import /vendor/etc/init/hw/init.mi_thermald.rc
import /odm/etc/init/hw/init.mi_ambient.rc

on early-init
    export ADSP_LIBRARY_PATH /odm/lib/rfsa/adsp;/vendor/lib/rfsa/adsp/;/system/lib/rfsa/adsp;/system/vendor/lib/rfsa/adsp;/dsp
    # set tcp_mtu_probing to 1
    write /proc/sys/net/ipv4/tcp_mtu_probing 1

on init
    # Initial uhid
    chmod 0666 /dev/uhid

on early-boot
    # Modem
    mkdir /data/vendor/modem 0777 root root
    mkdir /data/vendor/modem/diag_logs 0777 root root

    # Wait (1 second at most) for 'fs_ready' entry to be created
    wait /sys/kernel/cnss/fs_ready 1
    # Enable WLAN cold boot calibration
    write /sys/kernel/cnss/fs_ready 1

    # Fingerprint
    chown system graphics /sys/bus/platform/devices/soc:xiaomi_fingerprint/fingerdown
    chmod 0664 /sys/bus/platform/devices/soc:xiaomi_fingerprint/fingerdown

on fs
    restorecon_recursive /mnt/rescue

on boot
    setprop persist.bluetooth.a2dp_offload.disabled false

    # Carrier Hotspot DPI Bypass: Lock IPv4 TTL & IPv6 Hop Limit to 64
    exec - root root -- /system/bin/iptables -t mangle -A POSTROUTING -j TTL --ttl-set 64
    exec - root root -- /system/bin/ip6tables -t mangle -A POSTROUTING -j HL --hl-set 64

    # Maximize TCP 5G SA Socket Buffers (16MB)
    write /proc/sys/net/core/rmem_max 16777216
    write /proc/sys/net/core/wmem_max 16777216
    write /proc/sys/net/ipv4/tcp_rmem "4096 87380 16777216"
    write /proc/sys/net/ipv4/tcp_wmem "4096 65536 16777216"

    # f2fs per-IO accounting off for /data.
    #
    # system/core/rootdir/init.rc:1216 ("on boot") writes iostat_enable 1 as
    # part of its stock F2FS tuning block. That makes f2fs account every single
    # bio on the busiest filesystem on the device, sampled on a 1000ms period,
    # purely to populate iostat_info / the f2fs_iostat tracepoints.
    #
    # Nothing on this build consumes it: it is read by Perfetto's f2fs data
    # source and by bugreport dumps, both of which are on-demand. Checked on
    # device - no process holds iostat_info open.
    #
    # This override is in "on boot" and not an earlier trigger deliberately:
    # init.rc:1216 is itself in "on boot", and device rc files are parsed after
    # init.rc, so these commands are queued behind it in the same trigger and
    # win. Setting it in post-fs-data would run first and be overwritten.
    #
    # The /dev/sys/fs/by-name/userdata symlink is created a few lines above the
    # AOSP write, in the same trigger, so it already resolves here.
    # Verified at runtime: /sys/fs/f2fs/sda34 is /data on this device.
    write /dev/sys/fs/by-name/userdata/iostat_enable 0
    # Cap F2FS compress_cache at 10% of free RAM (Padat).
    write /dev/sys/fs/by-name/userdata/compress_percent 10

    # Create persist for camera calibration data
    mkdir /mnt/vendor/persist/camera 0755 system cameraserver
    # XIAOMI ADD: enableForceFullRecoveryForCRC
    chmod 0666 /sys/csiphy_umd_paras/csiphy_umd_paras
    # END: enableForceFullRecoveryForCRC

    #MIUI ADD:Thermal_NodeReq
    chown system system /sys/class/thermal/thermal_message/sconfig
    chown system system /sys/class/thermal/thermal_message/balance_mode
    chown cameraserver cameraserver /sys/class/thermal/thermal_message/torch_real_level
    chown cameraserver cameraserver /sys/class/thermal/thermal_message/flash_state
    chown system system /sys/class/thermal/thermal_message/charger_temp
    chown system system /sys/class/thermal/power_save/powersave_mode
    chown system system /sys/class/thermal/power_save/power_level
    chown system system /sys/class/thermal/thermal_message/board_sensor_temp_comp
    chown system system /sys/class/thermal/thermal_message/cpu_nolimit_temp
    #END Thermal_NodeReq

    # Bypass charging (MCA smart_charge): 0 = off, 1 = force, 2 = auto on game
    # scenes. bypass_charge_state reports "<state> <ibat_ma>" for the UI.
    chown system system /sys/class/xm_power/charger/smart_charge/bypass_charge
    chmod 0660 /sys/class/xm_power/charger/smart_charge/bypass_charge
    chown system system /sys/class/xm_power/charger/smart_charge/bypass_charge_state

    # Xiaomi touch
    chown system system /sys/class/touch/touch_dev/fod_longpress_gesture_enabled
    chmod 0660 /sys/class/touch/touch_dev/fod_longpress_gesture_enabled
    chown system system /sys/class/touch/touch_dev/gesture_double_tap_enabled
    chmod 0660 /sys/class/touch/touch_dev/gesture_double_tap_enabled
    chown system system /sys/class/touch/touch_dev/gesture_single_tap_enabled
    chmod 0660 /sys/class/touch/touch_dev/gesture_single_tap_enabled
    # Native single tap to wake, plus the pocket gate that stops the panel
    # gesture-scanning while covered. Both driven by XiaomiParts.
    chown system system /sys/class/touch/touch_dev/single_tap_to_wake
    chmod 0660 /sys/class/touch/touch_dev/single_tap_to_wake
    chown system system /sys/class/touch/touch_dev/touch_nonui_mode
    chmod 0660 /sys/class/touch/touch_dev/touch_nonui_mode

    # Fingerprint
    chmod 0666 /dev/xiaomi-fp
    chown system system /dev/xiaomi-fp
    chmod 0666 /dev/mifp_id
    chown system system /dev/mifp_id
    chmod 0666 /dev/input/event2
    chown system system /sys/bus/platform/devices/soc:xiaomi_fingerprint/intr2
    chmod 0666 /sys/bus/platform/devices/soc:xiaomi_fingerprint/intr2

on charger
    chown system system /sys/class/backlight/panel0-backlight/brightness
    write /sys/devices/system/cpu/qcom_lpm/parameters/sleep_disabled n
    write /sys/bus/platform/devices/1d84000.ufshc/clkscale_enable 1
    write /sys/bus/platform/devices/1d84000.ufshc/auto_hibern8 5000
    write /sys/bus/platform/devices/1d84000.ufshc/clkgate_enable 1
    # Re-arm power_off_mode here too, otherwise offline charging only ever happens once.
    # The flag is a one-shot handshake: XBL acts on 1 and writes 2 back, and
    # charger_partition_prepare() also lands on 2 a few seconds in. So if the user
    # unplugs during offline charging, the health HAL powers the phone off with the flag
    # already at 2, and the *next* cable insert boots straight into Android instead of
    # charging. Writing 1 back (after prepare, which is what the delay in the service's
    # script is for) keeps cable-insert-from-off going to offline charging every time.
    #
    # This does not trap the phone in charger mode: XBL also looks at the PON reason, so
    # a power-key press still cold-boots normally with the flag at 1. Confirmed in the
    # oops partition -- boot 4366 powered off with the flag armed to 1 and boot 4367 came
    # up "BOOT MODE:normal". It has to work that way, since stock's micharge HAL keeps
    # this flag armed the whole time Android is running.
    start set_charger_poweroff_mode

# Offline charging: delayed power_off_mode re-write service. Started from both the
# normal-boot path and "on charger", so the flag is armed whenever the phone might be
# powered on again by a cable insert.
#
# charger_partition_prepare() resets power_off_mode=2 ~5s in, when UFS SCSI becomes
# ready. This service writes power_off_mode=1 every 5 seconds for 25 seconds so that at
# least one write lands after prepare() has run. Nothing writes the flag after prepare,
# so the value then sticks for as long as the phone stays up.
service set_charger_poweroff_mode /vendor/bin/sh /vendor/bin/set_charger_poweroff_mode.sh
    class core
    user root
    group root system
    oneshot
    disabled

on post-fs-data
    chmod 0666 /sys/class/thermal/thermal_message/boost
    restorecon /sys/class/thermal/thermal_message/boost
    chmod 0666 /sys/devices/system/cpu/cpufreq/policy0/scaling_governor
    restorecon /sys/devices/system/cpu/cpufreq/policy0/scaling_governor

    # Camera
    mkdir /data/vendor/camera 0777 camera camera
    mkdir /data/vendor/camera/offlinelog 0777 cameraserver audio
    mkdir /data/vendor/camera/aftersalelog 0777 cameraserver audio
    # MIUI ADD: Camera_PerformanceEnhance
    mkdir /data/vendor/camera/overlay 0777 cameraserver audio
    # END Camera_PerformanceEnhance
    # MIUI ADD: Camera_CameraSkyNet
    chmod 0666 /dev/camlog
    #END Camera_CameraSkyNet

    #Create folder of memory
    mkdir /data/vendor/memory 0777 system system
    mkdir /data/vendor/memory/error_history 0777 system system
    mkdir /data/vendor/ssrdump 0777 root system
    mkdir /data/vendor/ramdump 0777 root system

    # Create directory used by video subsystem
    mkdir /data/vendor/video 0777 audio audio
    write /data/vendor/video/videohalPid 0
    chown audio audio /data/vendor/video/videohalPid
    chmod 0777 /data/vendor/video/videohalPid
    write /data/vendor/video/vppservicePid 0
    chown audio audio /data/vendor/video/vppservicePid
    chmod 0777 /data/vendor/video/vppservicePid

    # Create the directory used by qrtr-lookup
    mkdir /data/vendor/qrtr 0775 system system

    # add wlan log output path
    mkdir /data/vendor/wlan_logs 0777 root shell
    # use nv mac
    mkdir /data/vendor/mac_addr 0770 system wifi
    mkdir /mnt/vendor/persist/wlan 0770 system wifi

    # Fingerprint
    mkdir /data/vendor/misc 01771 system system
    mkdir /data/vendor/misc/mi_fp 0770 system system
    mkdir /persist/mi_fp 0770 system system
    mkdir /mnt/vendor/persist/mi_fp 0770 system system
    mkdir /data/vendor/fpc 0770 system system
    mkdir /data/vendor/fpdump 0770 system system
    mkdir /data/vendor/goodix 0770 system system
    mkdir /data/vendor/fpdata 0770 system system
    mkdir /data/vendor/fingerprint 0770 system system
    mkdir /mnt/vendor/persist/goodix 0770 system system
    mkdir /mnt/vendor/persist/fingerprint 0770 system system
    mkdir /data/vendor/fpdump/qfs4008 0770 system system
    mkdir /mnt/vendor/persist/fingerprint/meta 0770 system system
    mkdir /mnt/vendor/persist/fingerprint/jiiov 0770 system system

    # Display feature sysfs node
    chown system system /sys/class/mi_display/disp-DSI-0/disp_param
    chmod 0664 /sys/class/mi_display/disp-DSI-0/disp_param
    chown system system /sys/class/mi_display/disp-DSI-0/mipi_rw
    chmod 0664 /sys/class/mi_display/disp-DSI-0/mipi_rw
    chown system system /sys/class/mi_display/disp-DSI-0/panel_info
    chmod 0444 /sys/class/mi_display/disp-DSI-0/panel_info
    chown system system /sys/class/mi_display/disp-DSI-0/wp_info
    chmod 0444 /sys/class/mi_display/disp-DSI-0/wp_info
    chown system system /sys/class/mi_display/disp-DSI-0/dynamic_fps
    chmod 0444 /sys/class/mi_display/disp-DSI-0/dynamic_fps
    chown system system /sys/class/mi_display/disp-DSI-0/doze_brightness
    chmod 0664 /sys/class/mi_display/disp-DSI-0/doze_brightness

    # thermal config path
    mkdir /data/vendor/thermal 0771 root system
    mkdir /data/vendor/thermal/config 0771 root system
    chmod 0666 /sys/class/thermal/thermal_message/boost
    restorecon /sys/class/thermal/thermal_message/boost

    # add torch node for cit && mmi
    chown system system /sys/class/leds/led:torch_0/brightness
    chown system system /sys/class/leds/led:torch_1/brightness
    chown system system /sys/class/leds/led:torch_2/brightness
    chown system system /sys/class/leds/led:torch_3/brightness
    chown system system /sys/class/leds/led:flash_0/brightness
    chown system system /sys/class/leds/led:flash_1/brightness
    chown system system /sys/class/leds/led:flash_2/brightness
    chown system system /sys/class/leds/led:flash_3/brightness
    chown system system /sys/class/leds/led:switch_0/brightness
    chown system system /sys/class/leds/led:switch_1/brightness
    chown system system /sys/class/leds/led:switch_2/brightness
    chown system system /sys/class/leds/led:switch_3/brightness
    chown system system /sys/class/leds/led:switch_0/trigger
    chown system system /sys/class/leds/led:switch_1/trigger
    chown system system /sys/class/leds/led:switch_2/trigger
    chown system system /sys/class/leds/led:switch_3/trigger
    chown system system /sys/class/leds/flashlight/brightness

    chmod 0664 /sys/class/leds/led:torch_0/brightness
    chmod 0664 /sys/class/leds/led:torch_1/brightness
    chmod 0664 /sys/class/leds/led:torch_2/brightness
    chmod 0664 /sys/class/leds/led:torch_3/brightness
    chmod 0664 /sys/class/leds/led:flash_0/brightness
    chmod 0664 /sys/class/leds/led:flash_1/brightness
    chmod 0664 /sys/class/leds/led:flash_2/brightness
    chmod 0664 /sys/class/leds/led:flash_3/brightness
    chmod 0664 /sys/class/leds/led:switch_0/brightness
    chmod 0664 /sys/class/leds/led:switch_1/brightness
    chmod 0664 /sys/class/leds/led:switch_2/brightness
    chmod 0664 /sys/class/leds/led:switch_3/brightness
    chmod 0664 /sys/class/leds/led:switch_0/trigger
    chmod 0664 /sys/class/leds/led:switch_1/trigger
    chmod 0664 /sys/class/leds/led:switch_2/trigger
    chmod 0664 /sys/class/leds/led:switch_3/trigger
    chmod 0664 /sys/class/leds/flashlight/brightness

    #QCC mode configuration
    setprop vendor.qti.qcc.oper.mode 4

    chmod 0662 /dev/miev
    restorecon /dev/miev

on property:dev.bootcomplete=1
    chown system system /sys/class/xm_power/charger/smart_charge/smart_night
    chmod 0660 /sys/class/xm_power/charger/smart_charge/smart_night

    # Offline charging: arm power_off_mode=1 so XBL enters charger mode when the phone
    # is plugged in while powered off. Stock's micharge HAL does this; the dummy
    # replacement used here does not, so it has to happen from init.
    # power_off_mode: 0=unknown, 1=offline charging (show animation), 2=full shutdown
    #
    # charger_partition.ko RE notes (charger_partition_prepare @ .text+0x1aa8):
    #   The charger partition is sda22 (/dev/block/by-name/charger), header magic
    #   0x20240725 v2. info_1 is a 32-byte struct mapped onto driver base+168:
    #     +168 power_off_mode   +172 zero_speed_mode  +176 mishow
    #     +180 double85         +184 remove_temp_limit +188 soc_limit
    #     +192 memory_test      +196 reserved          +200 prop_eu_mode
    #   prepare() does one 64-bit store of 0x200000002 at base+168, i.e. it sets
    #   power_off_mode=2 AND zero_speed_mode=2 (power_off_mode is the LOW half).
    #   That reset is BY DESIGN -- the flag is a one-shot handshake consumed by XBL,
    #   not a bug to be fought. The kernel exports no getter for power_off_mode and
    #   no module imports one, so nothing in Linux reads it; only XBL does.
    #
    # prepare() runs ~5s in (when UFS SCSI becomes ready) and would clobber the value,
    # so write 1 now and start a delayed service to re-write it once prepare() is done.
    chown system system /sys/class/xm_power/charger/charger_partition/charger_partition_poweroffmode
    chmod 0660 /sys/class/xm_power/charger/charger_partition/charger_partition_poweroffmode
    write /sys/class/xm_power/charger/charger_partition/charger_partition_poweroffmode 1
    chown system system /sys/class/xm_power/charger/charger_partition/charger_partition_mishow
    chmod 0660 /sys/class/xm_power/charger/charger_partition/charger_partition_mishow
    start set_charger_poweroff_mode

# Enable WLAN SSR recovery
on property:persist.vendor.ssr.restart_level=ALL_ENABLE
    write /sys/kernel/cnss/recovery 3
    write /sys/devices/platform/soc/97000000.remoteproc-wpss/remoteproc/remoteproc3/recovery enabled

# Disable WLAN SSR recovery
on property:persist.vendor.ssr.restart_level=ALL_DISABLE
    write /sys/kernel/cnss/recovery 0

on property:sys.boot_completed=1
    write /dev/kmsg "start qrtr-lookup after Boot completed "
    start qrtr-lookup

    # Set thermal mode to mgame
    write /sys/devices/virtual/thermal/thermal_message/sconfig 19

    # for online boot cpu
    wait /sys/class/thermal/thermal_message/boot_complete
    write /sys/class/thermal/thermal_message/boot_complete 2

    # Enable PowerHAL hint processing
    setprop vendor.powerhal.init 1

    # 5G NR / LTE CA TCP & Mobile Data Buffer Optimization
    write /proc/sys/net/ipv4/tcp_rmem "4096 2097152 16777216"
    write /proc/sys/net/ipv4/tcp_wmem "4096 1048576 16777216"
    write /proc/sys/net/core/rmem_max 16777216
    write /proc/sys/net/core/wmem_max 16777216
    write /proc/sys/net/ipv4/tcp_slow_start_after_idle 0
    write /proc/sys/net/ipv4/tcp_notsent_lowat 131072
    write /proc/sys/net/ipv4/tcp_no_metrics_save 1
    write /proc/sys/net/ipv4/tcp_ecn 1
    write /proc/sys/net/ipv4/tcp_fastopen 3
    write /proc/sys/net/ipv4/tcp_comp_sack_delay_ns 0
    # Enable Receive Flow Steering (RFS) across all 8 cores
    write /proc/sys/net/core/rps_sock_flow_entries 32768
    write /sys/class/net/rmnet_data0/queues/rx-0/rps_flow_cnt 4096
    write /sys/class/net/rmnet_data1/queues/rx-0/rps_flow_cnt 4096
    write /sys/class/net/rmnet_data2/queues/rx-0/rps_flow_cnt 4096
    write /sys/class/net/rmnet_data3/queues/rx-0/rps_flow_cnt 4096
    # WCN7750 exposes 5 RX queues (rx-0..4); enable RFS across all queues
    write /sys/class/net/wlan0/queues/rx-0/rps_flow_cnt 4096
    write /sys/class/net/wlan0/queues/rx-1/rps_flow_cnt 4096
    write /sys/class/net/wlan0/queues/rx-2/rps_flow_cnt 4096
    write /sys/class/net/wlan0/queues/rx-3/rps_flow_cnt 4096
    write /sys/class/net/wlan0/queues/rx-4/rps_flow_cnt 4096

# wlan0 is created after sys.boot_completed=1 (when qca_cld3_wcn7750 loads FW),
# so apply RFS on all 5 RX queues whenever Wi-Fi brings wlan0 online.
on property:wifi.active.interface=wlan0
    write /sys/class/net/wlan0/queues/rx-0/rps_flow_cnt 4096
    write /sys/class/net/wlan0/queues/rx-1/rps_flow_cnt 4096
    write /sys/class/net/wlan0/queues/rx-2/rps_flow_cnt 4096
    write /sys/class/net/wlan0/queues/rx-3/rps_flow_cnt 4096
    write /sys/class/net/wlan0/queues/rx-4/rps_flow_cnt 4096

service cnss-daemon /system/vendor/bin/cnss-daemon -n -l --max_file_count 3 --max_file_size 20

service loc_launcher /system/vendor/bin/loc_launcher
    class late_start
    user gps
    group gps

service qrtr-lookup /vendor/bin/qrtr-lookup
    class core
    user system
    group system
    disabled
    oneshot

service vendor.nv_mac /vendor/bin/nv_mac
    class late_start
    user system
    group system inet net_admin wifi net_raw
    oneshot

service vendor.sensors-hal-multihal /vendor/bin/hw/android.hardware.sensors-service.xiaomi-multihal
    override
    class hal
    user system
    group system wakelock context_hub input uhid
    task_profiles ServiceCapacityLow
    socket audio_us_socket_1 seqpacket 0666 system system
    capabilities BLOCK_SUSPEND
    rlimit rtprio 10 10

service vendor.audio-hal-aidl /vendor/bin/hw/audiohalservice.qti
    override
    class hal
    user audioserver
    group audio media mediadrm drmrpc inet net_bt net_bt_admin net_bw_acct wakelock context_hub oem_2901 oem_2912
    capabilities BLOCK_SUSPEND SYS_NICE
    # setting RLIMIT_RTPRIO allows binder RT priority inheritance
    rlimit rtprio 10 10
    ioprio rt 4
    task_profiles ProcessCapacityHigh HighPerformance
    writepid /dev/cpuset/foreground/tasks /dev/stune/foreground/tasks
    socket audio_us_socket_0 seqpacket 0666 system system
    onrestart restart audioserver
