import /vendor/etc/init/hw/init.qti.kernel.rc

on early-init
    write /proc/sys/kernel/printk_devkmsg ratelimited
    export MEMTAG_OPTIONS off

on init
    wait /dev/block/platform/soc/${ro.boot.bootdevice}
    symlink /dev/block/platform/soc/${ro.boot.bootdevice} /dev/block/bootdevice
    chown system system /sys/devices/platform/soc/1d84000.ufshc/auto_hibern8
    chmod 0660 /sys/devices/platform/soc/1d84000.ufshc/auto_hibern8
    start logd

    # Under-display-ALS content writeback (triggerCwbThread in libclient2slpi.notifier.so,
    # loaded inside composer). Must be set here: odm build.prop loads after
    # /vendor/build.prop, and the composer (early_hal) reads this once at startup.
    #
    # This was previously 0 to stop the ~8 captures/sec storm, but that breaks auto-
    # brightness. The ALS sits under the panel at (762,115), so SLPI subtracts the screen's
    # own emission using panel_Info_cali_ori in odm/etc/sensors/config/lightSensorConfig.json.
    # Without CWB it has DBV but no content luminance, so it must assume a full-white screen
    # and over-subtracts: at DBV 940 that table predicts ~21700 channel units, about 320 lux
    # through channel_coef, against a real content contribution nearer 60 lux.
    #
    # Measured with it off: a full day of readings never exceeded 50 lux, and a torch aimed
    # straight at the sensor still read 50. That maps to 3.5-85 nits across the entire
    # range, so the screen could never get bright and auto-brightness looked dead.
    #
    # Keep at 1. If the capture rate becomes a power concern, gate the notifier on
    # adaptive-brightness state rather than disabling it outright.
    setprop vendor.display.enable_cwb_notify_sensor 1


on early-fs
    start vold

on fs
    mount_all --early
    chown root system /mnt/vendor/persist
    chmod 0771 /mnt/vendor/persist
    restorecon_recursive /mnt/vendor/persist
    mkdir /mnt/vendor/persist/data 0700 system system

on post-fs
    #Execute virtualization manager
    on property:ro.vendor.vm.ssr.enable=
        enable vendor.qvirtservice_rs
        start  vendor.qvirtservice_rs
    on property:ro.vendor.vm.ssr.enable=false
        enable vendor.qvirtservice_rs
        start  vendor.qvirtservice_rs
    on property:ro.vendor.vm.ssr.enable=true
        enable vendor.qvirtservice_rs
        start  vendor.qvirtservice_rs
        enable vendor.qvirtvendorservice
        start  vendor.qvirtvendorservice

on late-fs
    #exec_start wait_for_keymaster
    mount_all --late

on post-fs-data
    mkdir /vendor/data/tombstones 0771 system system
    # Enable WLAN cold boot calibration
    write /sys/kernel/cnss/fs_ready 1

on early-boot
    setprop ro.surface_flinger.supports_background_blur ${vendor.display.supports_background_blur}
    verity_update_state

on boot
    write /dev/cpuset/audio-app/cpus 0-1
    # Add a cpuset for the camera daemon
    # We want all cores for camera
    mkdir /dev/cpuset/camera-daemon
    write /dev/cpuset/camera-daemon/cpus 0-7
    write /dev/cpuset/camera-daemon/mems 0
    chown cameraserver cameraserver /dev/cpuset/camera-daemon
    chown cameraserver cameraserver /dev/cpuset/camera-daemon/tasks
    chmod 0660 /dev/cpuset/camera-daemon/tasks

    # Touch Optimization (Disable Palm & Edge Rejection for AOSP).
    # Both nodes are still real stores in the OSS xiaomi_touch driver:
    # palm_sensor forwards to hardware_operation.palm_sensor_write(), and
    # touch_thp_ic_cmd parses the command buffer (its *show* handler is the
    # stub, not the store).
    write /sys/devices/virtual/touch/touch_dev/palm_sensor 0
    write /sys/devices/virtual/touch/touch_dev/touch_thp_ic_cmd 0

    chown system /sys/devices/platform/soc/990000.i2c/i2c-0/0-0038/trusted_touch_enable
    chmod 0660 /sys/devices/platform/soc/990000.i2c/i2c-0/0-0038/trusted_touch_enable
    chown system /sys/devices/platform/soc/990000.spi/spi_master/spi0/spi0.0/trusted_touch_enable
    chmod 0660 /sys/devices/platform/soc/990000.spi/spi_master/spi0/spi0.0/trusted_touch_enable
    chown system /sys/devices/system/cpu/hyp_core_ctl/enable
    chown system /sys/devices/system/cpu/hyp_core_ctl/hcc_min_freq

on property:vendor.display.lcd_density=560
   setprop dalvik.vm.heapgrowthlimit 256m

on property:vendor.display.lcd_density=640
   setprop dalvik.vm.heapgrowthlimit 512m

on init && property:ro.boot.mode=charger
    wait_for_prop vendor.all.modules.ready 1
    mount_all /vendor/etc/charger_fw_fstab.qti --early

on charger
    start vendor.power_off_alarm
    write /sys/kernel/cnss/charger_mode 1

#service vendor.lowi /vendor/bin/sscrpcd
#   class core
#   user system
#   group system wakelock
#   capabilities BLOCK_SUSPEND

#pd-mapper
service vendor.pd_mapper /vendor/bin/pd-mapper
    class core
    user system
    group system

#Peripheral manager
service vendor.per_mgr /vendor/bin/pm-service
    class core
    user system
    group system
    ioprio rt 4

service vendor.per_proxy /vendor/bin/pm-proxy
    class core
    user system
    group system
    disabled

#service vendor.mdm_helper /vendor/bin/mdm_helper
#    class core
#    group system wakelock
#    disabled

service vendor.mdm_launcher /vendor/bin/sh /vendor/bin/init.mdm.sh
    class core
    oneshot

on property:init.svc.vendor.per_mgr=running
    start vendor.per_proxy

on property:sys.shutdown.requested=*
    write /sys/kernel/qcom_rproc/shutdown_in_progress 1
    stop vendor.per_proxy

on property:vold.decrypt=trigger_restart_framework
   start vendor.cnss_diag

service vendor.cnss_diag /system/vendor/bin/cnss_diag -q -f -t HELIUM
   class main
   user system
   group system wifi inet sdcard_rw media_rw diag
   oneshot

on early-boot && property:persist.vendor.pcie.boot_option=*
    write /sys/bus/platform/devices/1c00000.qcom,pcie/debug/boot_option ${persist.vendor.pcie.boot_option}
    write /sys/bus/platform/devices/1c08000.qcom,pcie/debug/boot_option ${persist.vendor.pcie.boot_option}

# Mirror Developer Options persist states to debug properties
on property:persist.sys.sf_layer_caching=*
    setprop debug.sf.enable_layer_caching ${persist.sys.sf_layer_caching}

on property:persist.sys.hwui_renderer=*
    setprop debug.hwui.renderer ${persist.sys.hwui_renderer}

on property:persist.sys.renderengine_backend=*
    setprop debug.renderengine.backend ${persist.sys.renderengine_backend}

# GameSpace dynamic WALT boost list.
# Node ini REPLACE-on-write, jadi selalu rekonstruksi full string:
# engine libs statis + package game aktif (atau "none" saat tidak ada sesi).
on property:persist.sys.gamespace.sched_lib_extra=*
    write /proc/sys/walt/sched_lib_name "UnityMain,libunity.so,libil2cpp.so,libUE4.so,libUE5.so,libgodot.so,libcocos2d.so,${persist.sys.gamespace.sched_lib_extra}"
    setprop vendor.display.game.packagename ${persist.sys.game.enhance.packagename}

on property:persist.sys.afme.smooth_motion=1
    setprop vendor.display.use_smooth_motion 1
    setprop vendor.perf.framepacing.enable 1

on property:persist.sys.afme.smooth_motion=0
    setprop vendor.display.use_smooth_motion 0
    setprop vendor.perf.framepacing.enable 0

# AFME session: raise the GPU devfreq floor while frame generation is
# active. The msm-adreno-tz governor never ramps for frame-paced games
# (measured: 300-515MHz at ~66% busy in ZZZ city → base fps too unstable
# for the layer's pacing target), and a floor set via adb resets on
# reboot. 763MHz = middle bin of the Adreno 840 frequency table.
on property:persist.sys.afme.session=1
    write /sys/class/kgsl/kgsl-3d0/devfreq/min_freq 763000000

on property:persist.sys.afme.session=0
    write /sys/class/kgsl/kgsl-3d0/devfreq/min_freq 150000000

