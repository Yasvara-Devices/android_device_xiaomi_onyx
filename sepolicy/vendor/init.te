set_prop(vendor_init, vendor_camera_prop)
set_prop(vendor_init, vendor_deviceid_prop)
set_prop(vendor_init, vendor_displayfeature_prop)
set_prop(vendor_init, vendor_mischeck_prop)
set_prop(vendor_init, vendor_qcc_prop)
set_prop(vendor_init, vendor_radio_prop)
set_prop(vendor_init, vendor_ssr_prop)
set_prop(vendor_init, vendor_thermal_normal_prop)
set_prop(vendor_init, vendor_touchfeature_prop)

allow vendor_init cgroup:file { getattr read write };
allow vendor_init device:chr_file getattr;
allow vendor_init miev_device:chr_file getattr;
allow vendor_init minidump_data_file:dir create_dir_perms;
allow vendor_init minidump_data_file:file create_file_perms;
allow vendor_init proc_hung_task:file rw_file_perms;
allow vendor_init proc_sched:file w_file_perms;
allow vendor_init sysfs:lnk_file setattr;

# FPS info
allow init vendor_sysfs_graphics:dir search;
allow init vendor_sysfs_graphics:file rw_file_perms;

# Suppress: init reads block device sde17 before proper labeling at early boot
dontaudit init tmpfs:blk_file read;
# Suppress: init writes to generic sysfs pid at boot
dontaudit init sysfs:file write;
# Suppress: init mounts tracefs at boot
dontaudit init debugfs_tracing_debug:dir mounton;
