# SPEC-0047: Onyx vendor-labelled GPU (kgsl) and fuel-gauge sysfs reads for `pantaud`.

allow pantaud vendor_sysfs_kgsl:dir r_dir_perms;
allow pantaud vendor_sysfs_kgsl:file r_file_perms;
allow pantaud vendor_sysfs_kgsl:lnk_file r_file_perms;
allow pantaud vendor_sysfs_kgsl_gpuclk:file r_file_perms;

allow pantaud vendor_sysfs_xm_power:dir r_dir_perms;
allow pantaud vendor_sysfs_xm_power:file r_file_perms;
allow pantaud vendor_sysfs_xm_power:lnk_file r_file_perms;
