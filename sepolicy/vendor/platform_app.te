# Camera
allow platform_app_all vendor_displayfeature_prop:file read;

get_prop(platform_app_all, vendor_camera_p3enable_prop)
get_prop(platform_app_all, vendor_displayfeature_prop)

# FPS info
allow platform_app_all vendor_sysfs_graphics:dir search;
allow platform_app_all vendor_sysfs_graphics:file r_file_perms;