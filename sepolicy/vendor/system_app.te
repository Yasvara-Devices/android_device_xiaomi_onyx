# Aware
get_prop(system_app, vendor_aware_available_prop);

# Pentas: Allow system_app to access Xiaomi Touch Feature HAL
# Required for XiaomiTouchFeatureClient (HTSR, SuperTouch, HotArea, etc.)
typeattribute system_app hal_touchfeature_xiaomi_client;
allow system_app hal_touchfeature_xiaomi_service:service_manager find;
binder_call(system_app, hal_touchfeature_xiaomi_default)

# Pentas: Allow reading GPU busy percentage (kgsl sysfs)
# Required for GPU usage monitor in Game Turbo overlay
allow system_app vendor_sysfs_kgsl:dir r_dir_perms;
allow system_app vendor_sysfs_kgsl:file r_file_perms;
allow system_app vendor_sysfs_kgsl:lnk_file r_file_perms;

# Pentas: Allow reading /proc/stat for CPU usage monitoring
# Denied: system_app → proc_stat:file { read open getattr }
allow system_app proc_stat:file r_file_perms;

# Pentas: Allow reading CPU frequency from sysfs
# Path: /sys/devices/system/cpu/cpu*/cpufreq/scaling_cur_freq
allow system_app sysfs_devices_system_cpu:file r_file_perms;
allow system_app sysfs_devices_system_cpu:dir r_dir_perms;

# Pentas: Allow reading GPU clock frequency from kgsl sysfs
# Path: /sys/class/kgsl/kgsl-3d0/gpuclk
allow system_app vendor_sysfs_kgsl_gpuclk:file r_file_perms;

# Pentas: bypass charging control (MCA smart_charge)
# Path: /sys/class/xm_power/charger/smart_charge/bypass_charge{,_state}
# The node is a symlink into /sys/devices/platform/soc/soc:smart_charge, which
# genfs_contexts already labels vendor_sysfs_xm_power - hence lnk_file too.
allow system_app vendor_sysfs_xm_power:dir r_dir_perms;
allow system_app vendor_sysfs_xm_power:file rw_file_perms;
allow system_app vendor_sysfs_xm_power:lnk_file r_file_perms;

# Pentas: dynamic quick-charge profile detection from Device Tree
# Path: /sys/firmware/devicetree/base/soc/mca_strategy_quick_charge/div_max_curr
r_dir_file(system_app, vendor_sysfs_devicetree_soc)

# Settings Hardware Info: allow reading DDR type, suppress generic sysfs probes
allow system_app vendor_sysfs_ddr:file r_file_perms;
dontaudit system_app sysfs:{ dir file } read;
