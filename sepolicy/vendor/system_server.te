#
# Thermal/performance control has been moved out of system_server:
# Pentas (system_app) now owns all kernel-node access — see
# pentas_app.te (vendor) and sepolicy/private/pentas_app.te.

# Battery supply temperature reading (battery stats / telemetry)
allow system_server vendor_sysfs_battery_supply:file r_file_perms;

# Suppress: InputReader scans /vendor/usr directory (keylayout/idc/keychars have own labels)
dontaudit system_server vendor_file:dir read;
